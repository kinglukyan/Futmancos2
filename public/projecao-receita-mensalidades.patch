+    function renderMembershipProjection() {
+      const input = document.getElementById('finProjectedPayers');
+      if (!input) return;
+
+      const paidMembers = players.filter(player => !isGoalkeeper(player) && (player.paid || player.paymentStatus === 'paid')).length;
+      if (input.dataset.initialized !== 'true') {
+        input.value = String(paidMembers);
+        input.dataset.initialized = 'true';
+      }
+
+      const enteredCount = input.value.trim();
+      const projectedPayers = enteredCount === '' ? 0 : Math.max(0, Math.floor(Number(enteredCount) || 0));
+      const monthlyFee = Math.max(0, Number(globalMonthlyFee) || 0);
+      const currency = value => Number(value).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
+
+      document.getElementById('finCurrentPaidMembers').innerText = String(paidMembers);
+      document.getElementById('finProjectionMonthlyFee').innerText = currency(monthlyFee);
+      document.getElementById('finProjectedMonthlyRevenue').innerText = currency(projectedPayers * monthlyFee);
+      document.getElementById('finProjectedAnnualRevenue').innerText = currency(projectedPayers * monthlyFee * 12);
+    }
